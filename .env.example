# Copy this file to ".env" and paste your keys in.
# .env is gitignored and is read only by the local API proxy (server/index.mjs).
# It is never bundled into the frontend and never reaches the browser.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recommended for any internet-facing deployment. Visitors enter this code in
# the app before they can run paid model requests.
WORKPLACE_ACCESS_CODE=

# Port the local API proxy listens on. Vite forwards /api here in dev.
PORT=8787

# Optional. Point a provider at a gateway, Azure, or a local mock instead of
# the vendor's public API. Omit both unless you know you need them.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
